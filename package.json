{
  "name": "vantage-statusboard",
  "version": "1.3.1",
  "description": "A portable Windows newsroom status board for Telestream Vantage transcodes.",
  "main": "src/main/main.js",
  "author": "KGAN Engineering",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-isolation=none test/*.test.js",
    "lint": "eslint .",
    "build": "npm run test && electron-builder --win portable",
    "build:dir": "electron-builder --dir --win"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "globals": "^16.3.0"
  },
  "build": {
    "appId": "com.sbg.kgan.vantage-statusboard",
    "productName": "Vantage Statusboard",
    "artifactName": "Vantage-Statusboard-${version}-portable.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Vantage-Statusboard-${version}-portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
